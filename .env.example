# Copy to .env and customize. .env is not committed.

# Database connection (SQLAlchemy URL). Default is local sqlite if unset.
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost/bittorch

# API key required by the /predict/*, /predictions/* endpoints.
# If unset, those endpoints reject all requests with 503 (disabled).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# HTTP timeout (seconds) for yfinance downloads.
YFINANCE_HTTP_TIMEOUT=10
