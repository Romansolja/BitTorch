# Copy to .env and customize. .env is not committed.

# Database connection (SQLAlchemy URL). Default is local sqlite if unset.
# For PostgreSQL, install a compatible driver yourself (e.g. `pip install psycopg[binary]`)
# and set a URL such as:
#   DATABASE_URL=postgresql+psycopg://user:pass@localhost/bittorch
# Only the default SQLite URL works out of the box with the pinned deps.

# API key required by the /predict/*, /predictions/* endpoints.
# If unset, those endpoints reject all requests with 503 (fail closed).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# HTTP timeout (seconds) for yfinance downloads.
YFINANCE_HTTP_TIMEOUT=10
